{
    "name": "portfolio/ai-content-api",
    "type": "project",
    "description": "Asynchronous product copy generation with Laravel, MySQL and Redis.",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "laravel/framework": "^11.57.1",
        "laravel/sanctum": "^4.0",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php artisan test",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {},
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-b41t-wbzk-9q51": {
                        "on-block": true,
                        "on-audit": false,
                        "reason": "Laravel 11 portfolio constraint. Uses Sanctum, not TokenGuard. Retained in audit; see docs/security.md."
                    },
                    "PKSA-d5tc-s1qs-h781": {
                        "on-block": true,
                        "on-audit": false,
                        "reason": "Laravel 11 portfolio constraint. APP_DEBUG=false; no public debug pages. Retained in audit; see docs/security.md."
                    },
                    "PKSA-m5cs-t1y6-qpcs": {
                        "on-block": true,
                        "on-audit": false,
                        "reason": "Laravel 11 portfolio constraint. No temporary filesystem URLs. Retained in audit; see docs/security.md."
                    },
                    "PKSA-3r5d-mb8f-1qw9": {
                        "on-block": true,
                        "on-audit": false,
                        "reason": "Laravel 11 portfolio constraint. No email input endpoints or mail delivery. Retained in audit; see docs/security.md."
                    },
                    "PKSA-mdq4-51ck-6kdq": {
                        "on-block": true,
                        "on-audit": false,
                        "reason": "Duplicate CRLF advisory record. No mail delivery; retained in audit. See docs/security.md."
                    }
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
